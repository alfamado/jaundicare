# Your deployed FastAPI URL. Do not include a trailing slash.
VITE_API_BASE_URL=https://jaundicare-api.onrender.com

# Optional public links. Leave blank until they are ready.
VITE_ANDROID_DOWNLOAD_URL=
VITE_CONTACT_EMAIL=

# Keep false for a public deployment. Set true only for the restricted
# presentation build while the backend is also in demo OTP mode.
VITE_DEMO_AUTH_ENABLED=false
