# Supabase: Dashboard -> Connect -> Session pooler. This IPv4 connection is
# the correct choice for a long-running Render web service on the Free plan.
# Keep sslmode=require and never commit the real password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
JWT_SECRET=
RATE_LIMIT_SALT=
TRUST_PROXY_HEADERS=false
ENABLE_TRAINING_IMAGE_STORAGE=false
TRAINING_IMAGE_RETENTION_DAYS=30
TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_SENDER_ID=OE Alert
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ALLOWED_HOSTS=localhost,127.0.0.1
MAMABOT_API_KEY=
VAXAI_API_KEY=
# Override only if the assistant provider gives you a corrected endpoint.
MAMABOT_URL=https://d2g5avlpkj63xl.cloudfront.net/chat
VAXAI_URL=https://d1vis8hpx6u9q0.cloudfront.net/chat
# ClinixTech Assist Core. ``retrieval`` is a deployed, source-backed fallback;
# ``cloudflare`` enables hosted Meta Llama without placing model files on Render.
# ``ollama`` is development-only and must not be used as the production path.
CLINIX_ASSIST_PROVIDER=retrieval
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_LLAMA_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
CLINIX_ASSIST_TIMEOUT_SECONDS=25
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# The partner API stays closed until organisation/key operations and external
# security review are ready. Never put a cxt_live key in a client application.
CLINIX_PARTNER_API_ENABLED=false
CLINIX_PARTNER_REQUESTS_PER_MINUTE=30
CLINIX_PARTNER_REQUESTS_PER_HOUR=500
# Per signed-in account and assistant; only user/assistant/time are retained.
MAX_CONSULT_REQUESTS_PER_MINUTE=6
MAX_CONSULT_REQUESTS_PER_HOUR=30
ENVIRONMENT=production
