# Supabase: Dashboard -> Connect -> Session pooler. This IPv4 connection is
# the correct choice for a long-running Render web service on the Free plan.
# Keep sslmode=require and never commit the real password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
JWT_SECRET=
RATE_LIMIT_SALT=
TRUST_PROXY_HEADERS=false
ENABLE_TRAINING_IMAGE_STORAGE=false
TRAINING_IMAGE_RETENTION_DAYS=30
TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_SENDER_ID=JaundiCare
# Presentation fallback only. Keeping disabled for normal Termii delivery.
OTP_DELIVERY_MODE=termii
DEMO_AUTH_ENABLED=false
DEMO_ALLOWED_PHONE_1="Abdulmalik_number"
DEMO_OTP_CODE_1="last six digits of Abdulmalik_number"
DEMO_ALLOWED_PHONE_2="Deborah_number"
DEMO_OTP_CODE_2="last six digits of Deborah_number"
DEMO_ALLOWED_PHONE_3="Bolu_Number"
DEMO_OTP_CODE_3="last six digits of Bolu_Number"
# Each approved phone can select Parent or Community Care only while
# OTP_DELIVERY_MODE=demo. This is ignored in normal SMS delivery mode.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ALLOWED_HOSTS=localhost,127.0.0.1
MAMABOT_API_KEY=
VAXAI_API_KEY=
# Override only if the assistant provider gives you a corrected endpoint.
MAMABOT_URL=https://d2g5avlpkj63xl.cloudfront.net/chat
VAXAI_URL=https://d1vis8hpx6u9q0.cloudfront.net/chat
# Keep false to use the live assistants configured above. The fallback is for
# a clearly labelled presentation response when an assistant key is unavailable.
CONSULTATION_DEMO_MODE=false
ENVIRONMENT=


# once termii is set up, the following settings will be used for production deployment
ENVIRONMENT=production
OTP_DELIVERY_MODE=termii
DEMO_AUTH_ENABLED=false
