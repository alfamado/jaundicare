DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/jaundicare
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
JWT_SECRET=
RATE_LIMIT_SALT=
TRUST_PROXY_HEADERS=false
ENABLE_TRAINING_IMAGE_STORAGE=false
TRAINING_IMAGE_RETENTION_DAYS=30
TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_SENDER_ID=JaundiCare
# Presentation fallback only. Keeping disabled for normal Termii delivery.
OTP_DELIVERY_MODE=termii
DEMO_AUTH_ENABLED=false
DEMO_ALLOWED_PHONE_1="Abdulmalik_number"
DEMO_OTP_CODE_1="last six digits of Abdulmalik_number"
DEMO_ALLOWED_PHONE_2="Deborah_number"
DEMO_OTP_CODE_2="last six digits of Deborah_number"
DEMO_ALLOWED_PHONE_3="Bolu_Number"
DEMO_OTP_CODE_3="last six digits of Bolu_Number"
# Optional presentation-only Community Care account. This value must match one
# of DEMO_ALLOWED_PHONE_1, DEMO_ALLOWED_PHONE_2, or DEMO_ALLOWED_PHONE_3.
DEMO_HEALTH_WORKER_PHONE=
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ALLOWED_HOSTS=localhost,127.0.0.1
MAMABOT_API_KEY=
VAXAI_API_KEY=
# Presentation fallback only. It returns clearly labelled local demo guidance
# when an assistant API key has not been supplied.
CONSULTATION_DEMO_MODE=false
ENVIRONMENT=


# once termii is set up, the following settings will be used for production deployment
ENVIRONMENT=production
OTP_DELIVERY_MODE=termii
DEMO_AUTH_ENABLED=false
DEMO_HEALTH_WORKER_PHONE=
