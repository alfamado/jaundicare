{
  "expo": {
    "name": "JaundiCare",
    "slug": "jaundicare",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "jaundicare",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jaundicare.app",
      "infoPlist": {
        "NSCameraUsageDescription": "JaundiCare uses the camera to photograph your baby for jaundice screening.",
        "NSPhotoLibraryUsageDescription": "JaundiCare needs access to your photo library to select a baby photo for screening.",
        "NSLocationWhenInUseUsageDescription": "JaundiCare uses your location to find nearby health facilities."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2d1a0e"
      },
      "package": "com.jaundicare.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "JaundiCare uses the camera to photograph your baby for jaundice screening.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "JaundiCare needs access to your photos to select a baby photo for screening."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JaundiCare uses your location to find nearby health facilities."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#d95f3b",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "gradleVersion": "8.13",
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "packagingOptions": {
              "pickFirst": [
                "**/libcrypto.so",
                "**/libssl.so"
              ]
            }
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "onnxruntime-react-native",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
